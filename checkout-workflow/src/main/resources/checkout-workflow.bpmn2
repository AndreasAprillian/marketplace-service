    <bpmn2:property id="region" itemSubjectRef="_regionItem" name="region"/>
    <bpmn2:property id="orderId" itemSubjectRef="_orderIdItem" name="orderId"/>
    <bpmn2:property id="subtotal" itemSubjectRef="_subtotalItem" name="subtotal"/>
    <bpmn2:property id="shippingCost" itemSubjectRef="_shippingCostItem" name="shippingCost"/>
    <bpmn2:property id="discount" itemSubjectRef="_discountItem" name="discount"/>
    <bpmn2:property id="total" itemSubjectRef="_totalItem" name="total"/>
    <bpmn2:property id="stockAvailable" itemSubjectRef="_stockAvailableItem" name="stockAvailable"/>
    <bpmn2:property id="orderExists" itemSubjectRef="_orderExistsItem" name="orderExists"/>
    <bpmn2:sequenceFlow id="_SF1" sourceRef="_START" targetRef="_VALIDATE_CART"/>
    <bpmn2:sequenceFlow id="_SF2" sourceRef="_VALIDATE_CART" targetRef="_CHECK_STOCK"/>
    <bpmn2:sequenceFlow id="_SF3" sourceRef="_CHECK_STOCK" targetRef="_STOCK_GW"/>
    <bpmn2:sequenceFlow id="_SF5" name="Not available" sourceRef="_STOCK_GW" targetRef="_ORDER_FAILED">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Not available]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return !stockAvailable;]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_SF6" sourceRef="_ORDER_FAILED" targetRef="_END_FAILED"/>
    <bpmn2:sequenceFlow id="_SF4" name="Available" sourceRef="_STOCK_GW" targetRef="_CALC_SUBTOTAL">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Available]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return stockAvailable;]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_SF7" sourceRef="_CALC_SUBTOTAL" targetRef="_CALC_SHIPPING"/>
    <bpmn2:sequenceFlow id="_SF8" sourceRef="_CALC_SHIPPING" targetRef="_CALC_DISCOUNT"/>
    <bpmn2:sequenceFlow id="_SF9" sourceRef="_CALC_DISCOUNT" targetRef="_CALC_TOTAL"/>
    <bpmn2:sequenceFlow id="_SF10" sourceRef="_CALC_TOTAL" targetRef="_ORDER_VALIDATION"/>
    <bpmn2:sequenceFlow id="_SF16" sourceRef="_ORDER_VALIDATION" targetRef="_ORDER_EXISTS_GW"/>
    <bpmn2:sequenceFlow id="_SF12" name="New order" sourceRef="_ORDER_EXISTS_GW" targetRef="_CREATE_ORDER">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[New order]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return !orderExists;]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_SF13" sourceRef="_CREATE_ORDER" targetRef="_MERGE_GW"/>
    <bpmn2:sequenceFlow id="_SF11" name="Already exists" sourceRef="_ORDER_EXISTS_GW" targetRef="_MERGE_GW">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Already exists]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return orderExists;]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_SF14" sourceRef="_MERGE_GW" targetRef="_PROCESS_PAYMENT"/>
    <bpmn2:sequenceFlow id="_SF15" sourceRef="_PROCESS_PAYMENT" targetRef="_END_DONE"/>
    <bpmn2:startEvent id="_START" name="Checkout Request Received">
      <bpmn2:extensionElements>
