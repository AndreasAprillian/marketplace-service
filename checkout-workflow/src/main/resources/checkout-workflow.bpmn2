  <bpmn2:process id="checkout_workflow" drools:packageName="org.acme.order" drools:version="1.0" drools:adHoc="false" name="Checkout Workflow" isExecutable="true" processType="Public">
    <bpmn2:documentation><![CDATA[Mensimulasikan alur OrderWorkflowService.processOrder pada order-service: validasi keranjang, cek stok, hitung subtotal/ongkir/diskon/total, cek duplikat order, buat order, lalu proses pembayaran. Publikasi event PAYMENT_PROCESSED atau ORDER_FAILED diganti menjadi catatan PaymentEventLog in-memory.]]></bpmn2:documentation>
