      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_CHECK_STOCK_ResultOutputX</bpmn2:sourceRef>
        <bpmn2:targetRef>stockAvailable</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:serviceTask>
